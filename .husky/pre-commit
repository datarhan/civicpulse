# Fail closed on real errors; warnings stay warnings (by design).
# If ESLint takes too long, consider 'lint-staged' to check only changed files.
cd "$(git rev-parse --show-toplevel)"
npm run lint --silent
# Keep Prettier formatting from drifting (run `npm run format` to auto-fix).
npm run format:check --silent

# Refuse to commit an unparseable snapshot or a merge-conflict marker.
# Nightly would catch it, but a day later and already on main — which is exactly
# what happened to pleno-votes-suggestions.json (ffab006). Milliseconds.
npm run check:json --silent

# Y refúsate a comitear un SECRETO.
#
# El 1-sep-2026 la clave de Gemini entró en un commit —dentro de dos mapas de
# voces— y se empujó al remoto en tres ramas. Nadie la escribió: el manifiesto
# guarda el MOTIVO de un trozo fallido, el motivo es el `err.message` de
# `execFileSync`, y ese mensaje lleva el argv del curl con `?key=…`. Y en cuanto
# se montó esta guarda encontró un segundo secreto que llevaba comiteado desde
# el 20-abr-2026: el token real del bot de Telegram, a pelo en bot/DEPLOY.md.
#
# Se mira sólo lo ESTAMPADO, para que el gancho siga costando milisegundos.
# Rotar la credencial es lo primero; borrar la línea no la saca de git.
npm run check:secrets --silent -- --staged

# Y refúsate a comitear desde un árbol PODADO.
#
# Aquí no se usa `sparse-checkout` en ningún sitio, así que si aparece uno viene
# de fuera — y poda: ficheros rastreados desaparecen del disco marcados
# `skip-worktree`, sin que `git status` eche nada en falta, porque para git no
# falta nada. Pasó cuatro veces entre el 18 y el 23 de agosto de 2026 y una de
# ellas se llevó `docs/` entero; se descubrió de casualidad al fallar un
# `git add`. Comitear así es comitear a ciegas sobre medio repositorio.
#
# Sólo tiñe la poda ACTIVA. Un fichero de patrones apagado se informa y deja
# pasar. Se devuelve todo con: npm run check:sparse -- --fix
npm run check:sparse --silent
