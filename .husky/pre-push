# Read the pages as a visitor before they reach production.
#
# Event-shaped, not time-shaped: it runs only when the push actually touches the
# data or the copy that a page renders. A nightly cron re-reading unchanged prose
# is how this kind of check earns a reputation for crying wolf and gets muted.
#
# NEVER blocks. A probabilistic check that can block a push teaches everyone to
# type --no-verify, and then it protects nothing. It prints and gets out of the
# way; you decide.
#
# That paragraph was a promise, and the promise was false for eight commits.
# Husky runs this file as `sh -e` (see .husky/_/h). Under -e, a command that
# fails INSIDE the EXIT trap aborts the shell with its status — and the trap's
# `kill $PREVIEW` failed every time, because a developer's own preview already
# held :4173, `--strictPort` killed this one at birth, and by cleanup time the
# corpse had been reaped. Exit 1. Push refused. The hook printed "el push
# continúa" on its way out.
#
# So "never blocks" is now structural, and it takes all three of these:
#   1. `set +e`, so a failing command cannot abort anything;
#   2. a cleanup whose last command is `:`, so the trap cannot return non-zero;
#   3. an explicit `exit 0` on every path.
# (2) and (3) are not redundant with (1) and not with each other: measured under
# `sh -e`, a trailing `exit 0` alone still exits 1, because the trap runs after
# it and overrides it. Do not delete one because the other looks sufficient.
set +e

cd "$(git rev-parse --show-toplevel)" || exit 0

# What is actually being pushed?
#
# `PREPUSH_RANGE` existe para poder EJECUTAR este gancho sin empujar nada:
#   PREPUSH_RANGE=HEAD~3..HEAD sh .husky/pre-push
# Un control que sólo se ejerce empujando de verdad es un control que nadie
# prueba, y este repositorio ya ha pagado dos veces por guardas sin dientes
# comprobados. No cambia nada en un push real, donde la variable no está.
#
# TRES PUNTOS, y no es cosmético. En `git diff`, `A..B` compara las dos PUNTAS,
# no «lo que trae B»: si tu rama está detrás de main, todo lo que cambió MAIN
# cuenta como cambiado por tu push. Medido sobre la PR #26:
#
#   origin/main..HEAD    45 ficheros → 10 rutas
#   origin/main...HEAD   23 ficheros →  2 rutas   ← las que el push tocaba
#
# Y se retroalimentaba: `--rotate` ordena por antigüedad, así que las ocho rutas
# fantasma —sin leer hace tiempo— se colocaban DELANTE de las dos reales, que
# acababan de leerse, y con el tope de 180 s sólo daba tiempo a una. O sea que
# cuanto más al día estaba una página, menos probable era que la leyera. El
# gancho leía sistemáticamente las rutas que el push NO había tocado.
#
# `PREPUSH_RANGE=HEAD~3..HEAD` sigue siendo correcto: en un rango lineal los dos
# puntos y los tres dan lo mismo.
#
# Y los tres puntos NO BASTAN si `origin/main` está rancio: el merge-base se
# calcula contra un main viejo y vuelven a colarse las rutas que ya están
# fusionadas. Se descubrió midiendo este mismo arreglo — PR fusionada en
# GitHub, sin `git fetch` después, y el gancho anunció otra vez 10 rutas donde
# eran 0. Es el caso NORMAL, no el raro: se fusiona y se sigue trabajando.
#
# Así que se refresca esa rama y sólo esa, y con reloj: si no hay red se sigue
# con lo que haya y se DICE, porque un gancho que exige red es un gancho que se
# salta en un tren — y porque el rango inflado es justo lo que hay que poder
# explicar cuando aparezca.
if [ -z "$PREPUSH_RANGE" ]; then
  git fetch --quiet --no-tags origin main 2>/dev/null &
  FETCH=$!
  ESPERA=0
  while [ "$ESPERA" -lt 40 ] && kill -0 "$FETCH" 2>/dev/null; do
    sleep 0.25
    ESPERA=$((ESPERA + 1))
  done
  if kill -0 "$FETCH" 2>/dev/null; then
    kill "$FETCH" 2>/dev/null
    echo "[pre-push] origin/main no se pudo refrescar en 10s — el rango puede venir inflado."
  fi
  wait "$FETCH" 2>/dev/null
fi
RANGE="${PREPUSH_RANGE:-origin/main...HEAD}"
git rev-parse --verify origin/main >/dev/null 2>&1 || RANGE="HEAD"
CHANGED=$(git diff --name-only "$RANGE" 2>/dev/null)
[ -z "$CHANGED" ] && exit 0

# QUÉ rutas, no cuáles tocaba la lista fija.
#
# Antes esto era un grep que decidía SI correr, y a continuación se revisaba el
# conjunto por defecto —seis rutas— con 60 segundos. Medido: una ruta cuesta del
# orden de un minuto, así que cada push leía UNA y la rotación tardaba media
# docena de pushes en dar la vuelta. Los tres defectos de /hallazgos de hoy los
# encontró una pasada a mano; el gancho llevaba tres pushes sin llegar a esa
# página.
#
# Ahora se pregunta al grafo de imports qué rutas puede haber roto ESTE push, y
# se revisan ésas, todas. Casi siempre son una o dos. El grep de antes además
# ignoraba src/hooks, src/lib y src/scraper —de donde sale la mitad de la prosa
# derivada—, así que un cambio ahí no disparaba nada.
RUTAS=$(printf '%s\n' "$CHANGED" | npx tsx scripts/routes-for-changes.ts --stdin 2>/dev/null)
[ -z "$RUTAS" ] && exit 0
N_RUTAS=$(printf '%s\n' "$RUTAS" | wc -l | tr -d ' ')

# Needs a $0 backend. If claude-code is not usable, say so and move on rather
# than silently skipping — a check nobody knows was skipped is worse than none.
if ! command -v claude >/dev/null 2>&1; then
  echo "[pre-push] revisar-superficies: claude CLI ausente — revisión omitida."
  exit 0
fi

STARTED=$(date +%s)
echo "[pre-push] este push toca $N_RUTAS ruta(s): $(printf '%s ' $RUTAS)"

# El presupuesto se ESCALA con lo que hay que leer, pero con un techo BAJO.
#
# 150s por ruta sale del peor caso medido (/quejas 60s, /eficiencia 128s,
# /plenos 141s) y es un TECHO, no una duración: una ruta rápida sigue tardando
# lo que tarda.
#
# El tope global es 180s y no 480 porque desde que existe el barrido nocturno
# esto ya no es el único lector del sitio, es el rápido. Con 480 un push que
# tocaba siete rutas se quedaba cinco minutos y medio parado, y un gancho que
# hace eso se salta con --no-verify a la tercera — que es como se pierde un
# control, no fallando sino cansando. Lo que no quepa aquí lo lee el barrido a
# las 07:30, y `--rotate` hace que las que se queden fuera hoy entren mañana.
#
# Si quieres la pasada entera y sin prisa sobre lo que acabas de tocar:
#   npm run review:surfaces -- <ruta>
PRESUPUESTO=$((N_RUTAS * 150))
[ "$PRESUPUESTO" -gt 180 ] && PRESUPUESTO=180
echo "[pre-push] leyendo esas páginas como un lector (hasta ${PRESUPUESTO}s)…"
# CON LAS BANDERAS DE LANZAMIENTO, las mismas que pone el despliegue.
#
# Sin ellas /eficiencia y /gestion no se montan, App.jsx manda cualquier ruta
# desconocida a `/`, y la revisión leía la PORTADA creyendo leer la ruta pedida:
# «cobertura 100% · nada que señalar» sobre otra página. Medido — pidió
# /eficiencia y midió 7.570 caracteres, que son los de `/`.
#
# El script ahora además compara dónde aterrizó con lo que pidió y lo canta como
# NO MONTADA en vez de revisarlo, así que esto son dos capas y no una: la
# bandera evita el caso, y la comprobación evita que vuelva en silencio si
# alguien añade una ruta tras otra bandera.
VITE_ENABLE_PERIODISTAS=true VITE_ENABLE_EFICIENCIA=true \
  npm run build >/dev/null 2>&1 || { echo "[pre-push] build falló; se omite la revisión."; exit 0; }

# Its OWN port, never the 4173 a developer runs `npm run preview` on. Sharing it
# was not a cosmetic clash: `--strictPort` made this preview exit instantly, the
# review then read the OTHER server's older build without either of them saying
# so, and the dead pid is what leaked the failing status. Take a free port or
# take none.
PORT=4189
while [ "$PORT" -lt 4210 ] && curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/"; do
  PORT=$((PORT + 1))
done

npx vite preview --host 127.0.0.1 --port "$PORT" --strictPort >/dev/null 2>&1 &
PREVIEW=$!
LOG=$(mktemp -t cp-review)
cleanup() {
  [ -n "$PREVIEW" ] && kill "$PREVIEW" 2>/dev/null
  [ -n "$LOG" ] && rm -f "$LOG"
  : # load-bearing: the trap's status is the hook's status. See the header.
}
trap 'cleanup' EXIT

# Poll, do not sleep. `sleep 5` was both too long when the server was already up
# and too short when it was not — and a preview that never came up renders every
# page empty, which is a run that reviewed nothing, not a clean site.
READY=""
TRIES=0
while [ "$TRIES" -lt 60 ]; do
  curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/" && { READY=1; break; }
  sleep 0.25
  TRIES=$((TRIES + 1))
done
if [ -z "$READY" ]; then
  echo "[pre-push] el preview no levantó en :$PORT — revisión OMITIDA (omitida ≠ limpia)."
  exit 0
fi

# ACOTADA, y dice lo que costó la cota. Git mata el gancho a los diez minutos,
# que es como esto llegó a bloquear una vez. El presupuesto ya va escalado a las
# rutas que este push toca, así que lo normal es que sobre; cuando no sobra, el
# script nombra las que no alcanzó y se niega a cachear un fragmento que no
# leyó. `--rotate` es lo que impide que, cuando no quepan, sean siempre las
# mismas: empieza por las que lleven más tiempo sin leerse.
#
# `npm run review:surfaces` sin presupuesto sigue siendo la pasada completa
# sobre el conjunto por defecto, a demanda.
set -a; [ -f .env ] && . ./.env >/dev/null 2>&1; set +a
env -u OPENAI_API_KEY -u ANTHROPIC_API_KEY \
    GEMINI_BIN=/nonexistent-disabled AGY_BIN=/nonexistent-disabled \
    LLM_BACKEND=claude-code LLM_CONCURRENCY=1 \
    REVIEW_BASE_URL="http://127.0.0.1:$PORT" \
    npm run --silent review:surfaces -- --budget-seconds "$PRESUPUESTO" --rotate $RUTAS 2>&1 | tee "$LOG"

# No `|| true` on that: it was there before and it never protected anything —
# the status leaked around it through the trap. `set +e` is what protects it.
#
# Making the hook unable to block re-opens the failure it was built against:
# nobody reads an exit code that can no longer stop anything, so the LAST LINE is
# the whole report. `[review]` is the summary the script prints once it has
# something to say about coverage; without it the run died before reviewing
# anything, and found in fault injection printing «parcial por diseño» over a
# Playwright crash. A hook that cannot block must at minimum refuse to imply it
# looked.
#
# Y distingue COMPLETA de PARCIAL. Decía «parcial por diseño» siempre, incluso
# cuando había leído entero lo que tocaba: un resumen que se declara incompleto
# pase lo que pase no informa de nada, y entrena a no leerlo — que es la misma
# avería, en la otra dirección, que un verde que no midió nada.
if grep -q '^\[review\]' "$LOG" 2>/dev/null; then
  DURACION=$(( $(date +%s) - STARTED ))
  if grep -qE 'NO se llegó a|PARCIAL' "$LOG" 2>/dev/null; then
    echo "[pre-push] ⚠︎ revisión PARCIAL (${DURACION}s): no dio tiempo a todas las rutas que toca este push."
    echo "[pre-push]   Las que faltan van arriba. Pásalas con: npm run review:surfaces -- <ruta>"
  else
    echo "[pre-push] revisión completa de las $N_RUTAS ruta(s) que toca este push (${DURACION}s) — informativa, nunca bloquea."
  fi
else
  echo "[pre-push] ⚠︎ la revisión NO llegó a emitir resumen — NO SE REVISÓ NADA ($(( $(date +%s) - STARTED ))s)."
  echo "[pre-push]   El push continúa igualmente, porque este gancho nunca bloquea, pero nadie ha leído estas páginas."
fi
exit 0
