# Get from @BotFather on Telegram
BOT_TOKEN=

# Telegram channel ID (with the minus sign for channels: -1001234567890)
# The bot must be an admin in this channel to broadcast state transitions.
# Leave empty to disable channel broadcasts (dev mode).
CHANNEL_ID=

# SQLite path (created on first run)
DB_PATH=./data/bot.db

# Leave empty for long-polling mode (dev). Set to a full https URL for
# webhook mode (production, e.g. behind Fly.io / Railway / Cloudflare tunnel).
WEBHOOK_URL=
PORT=3000

# Path to the front-end's officials.json — used by the queja-router to name
# the responsible concejal on every queja reply.
OFFICIALS_JSON=../public/data/officials.json

# Path where exported public JSON lands. The front-end reads this file at
# /data/quejas.json via useQuejas().
QUEJAS_JSON_OUT=../public/data/quejas.json
