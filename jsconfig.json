{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noImplicitAny": false,
    "strict": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests/e2e", "public/data", ".llm-cache"]
}
