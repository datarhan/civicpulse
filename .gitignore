# .claude is local (settings, locks) EXCEPT skills, which are shared team
# procedures checked into the repo (a directory-pattern ignore would block
# the negation, hence the /* form).
.claude/*
!.claude/skills/
playwright-report/
test-results/
.llm-cache/
.embed-cache/
.run-manifests/
eval/scorecards/
.press-cache/
.research-cache/
.curator-jobs/
.voiceprints/
tmp/
mlx_models/
editorial/
scripts/logs/

# Visual brainstorming companion (local mockups)
.superpowers/

# refine-transcript --apply local backups of the pristine Whisper output
public/data/pleno-transcripts/*.txt.orig

# P2 deterministic base — reproducible via `npm run verify:pleno-claims`; only
# the overlay (curator/NLI decisions) + the merged verified.json are committed.
public/data/pleno-claims-verified-base.json
# P2 re-grounding review queue — derived/threshold-dependent; regenerate via
# `npm run reground:verdicts`. A curator working file, not committed.
public/data/pleno-claims-regrounding-flags.json
.review-cache.json

# macOS/iCloud duplicate-file artifacts ("foo 2.ts", "index 2").
# This repo lives under ~/Documents; the sync service periodically clones files
# with a " 2" suffix. One such clone landed in .git/refs and broke every push
# until it was found, and a duplicate of a script was committed before anyone
# noticed. No legitimate file here has " 2" in its name — verified against
# `git ls-files` — so ignoring the pattern is safe and stops the next one.
*\ 2
*\ 2.*

# Alert de-duplication state for check:transcription-health (local, per-machine).
.transcription-health-state.json
.health-monitor-state.json
