{
  "name": "civicpulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src scripts bot/src bot/tests",
    "lint:fix": "eslint --fix src scripts bot/src bot/tests",
    "format": "prettier -w src scripts bot/src bot/tests",
    "format:check": "prettier -c src scripts bot/src bot/tests",
    "scrape:officials": "npx tsx scripts/scrape-officials.ts",
    "scrape:budget": "npx tsx scripts/scrape-budget.ts",
    "scrape:tenders": "npx tsx scripts/scrape-tenders.ts",
    "scrape:padron": "npx tsx scripts/scrape-padron.ts",
    "scrape:participa": "npx tsx scripts/scrape-participa.ts",
    "scrape:press": "npx tsx scripts/scrape-press.ts",
    "scrape:geo": "npx tsx scripts/scrape-geo.ts",
    "scrape:metro-network": "npx tsx scripts/scrape-metro-network.ts",
    "scrape:fgv-gtfs": "npx tsx scripts/scrape-fgv-gtfs.ts",
    "scrape:bdns": "npx tsx scripts/scrape-bdns.ts",
    "scrape:paro": "npx tsx scripts/scrape-paro.ts",
    "scrape:plenos": "npx tsx scripts/scrape-plenos.ts",
    "scrape:wikidata": "npx tsx scripts/scrape-wikidata.ts",
    "scrape:promise-suggestions": "npx tsx scripts/scrape-promise-suggestions.ts",
    "scrape:pleno-agendas": "npx tsx scripts/scrape-pleno-agendas.ts",
    "scrape:ctbg": "npx tsx scripts/scrape-ctbg.ts",
    "scrape:consell-cv": "npx tsx scripts/scrape-consell-cv.ts",
    "scrape:pleno-videos": "npx tsx scripts/scrape-pleno-videos.ts",
    "scrape:spain-ticker": "npx tsx scripts/scrape-spain-ticker.ts",
    "transcribe:pleno": "bash scripts/transcribe-pleno.sh",
    "transcribe:batch": "bash scripts/transcribe-pleno-batch.sh",
    "llm:doctor": "npx tsx scripts/llm-doctor.ts",
    "scrape:tender-queja-correlations": "npx tsx scripts/scrape-tender-queja-correlations.ts",
    "freeze:set": "npx tsx scripts/set-promises-freeze.ts set",
    "freeze:clear": "npx tsx scripts/set-promises-freeze.ts clear",
    "freeze:status": "npx tsx scripts/set-promises-freeze.ts status",
    "reply": "npx tsx scripts/apply-promise-response.ts",
    "route-queja": "npx tsx scripts/route-queja.ts",
    "queja-reply": "npx tsx scripts/apply-queja-response.ts",
    "sindic:add": "npx tsx scripts/add-sindic-resolucion.ts",
    "pleno-vote": "npx tsx scripts/apply-pleno-vote.ts",
    "promote-vote": "npx tsx scripts/promote-pleno-vote-suggestion.ts",
    "compute:dept-stats": "npx tsx scripts/compute-dept-stats.ts",
    "extract:pleno-votes": "npx tsx scripts/extract-pleno-votes.ts",
    "extract:all-pleno-votes": "npx tsx scripts/extract-pleno-votes.ts --all --engine llm --min-confidence 0.5",
    "extract:pleno-claims": "npx tsx scripts/extract-pleno-claims.ts",
    "extract:all-pleno-claims": "npx tsx scripts/extract-pleno-claims.ts --all --min-confidence 0.5",
    "verify:pleno-claims": "npx tsx scripts/verify-pleno-claims.ts",
    "extract-and-verify:pleno-claims": "bash scripts/extract-and-verify-pleno-claims.sh",
    "promote-claim": "npx tsx scripts/promote-claim.ts",
    "finding-reply": "npx tsx scripts/apply-finding-response.ts",
    "llm:cost": "npx tsx scripts/llm-cost-report.ts",
    "scrape:all": "npm run scrape:officials && npm run scrape:budget && npm run scrape:tenders && npm run scrape:padron && npm run scrape:participa && npm run scrape:press && npm run scrape:geo && npm run scrape:metro-network && npm run scrape:fgv-gtfs && npm run scrape:bdns && npm run scrape:paro && npm run scrape:plenos && npm run scrape:pleno-agendas && npm run scrape:wikidata && npm run scrape:ctbg && npm run scrape:consell-cv && npm run scrape:spain-ticker && npm run scrape:promise-suggestions && npm run extract:all-pleno-votes || true ; npm run compute:dept-stats",
    "prepare": "husky || true"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
