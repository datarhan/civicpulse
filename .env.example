# ─── LLM advisory layer ─────────────────────────────────────────────────────
# The LLM client powers three suggestion engines (pleno-vote extraction,
# promise evidence mining, tender↔queja correlation). All outputs flow into
# *-suggestions.json files flagged requiresHumanApproval:true and are NEVER
# substituted for curator-verified records. See src/llm/client.ts.

# Which backend: "ollama" (local, free), "openai" (cloud, paid), or
# "anthropic" (cloud, paid, recommended for vote extraction — handles noisy
# Spanish/Valencian Whisper transcripts better than local quants and uses
# prompt caching to amortise the long system prompt across segments).
# Default: ollama.
LLM_BACKEND=ollama

# Ollama configuration (only used when LLM_BACKEND=ollama).
# One-time setup: `brew install ollama && ollama pull qwen2.5:14b-instruct`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# OpenAI configuration (only used when LLM_BACKEND=openai).
# gpt-4o-mini costs ~$0.15/1M input tokens; a full nightly run is <$1/month.
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Anthropic configuration (only used when LLM_BACKEND=anthropic).
# claude-haiku-4-5 is the default — cheap + fast for structured extraction.
# Pricing (2026-04): input $1/M · output $5/M · cache-read $0.10/M. With
# prompt caching the pleno-vote system prompt is written once per pleno and
# read cheaply on every subsequent segment call — total cost per pleno is
# typically under $0.05.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# claude-code backend (only used when LLM_BACKEND=claude-code).
# Spawns the `claude` CLI in -p mode with --json-schema for structured output.
# Works with an Anthropic Max plan — no API key needed, uses the CLI's OAuth
# session. Rate-limited by the Max plan's session/weekly caps rather than
# billed per-token, so total_cost_usd in telemetry is informational only.
# Requires `claude` on PATH (brew install claude or npm install -g @anthropic-ai/claude-code).
CLAUDE_CODE_MODEL=haiku
CLAUDE_CODE_BIN=claude

# Hard token budget per CLI run — fails closed when exceeded. Protects against
# a runaway loop spending unbounded tokens on OpenAI. 500k tokens ≈ $0.075 on
# gpt-4o-mini or ~50 minutes of Ollama CPU inference.
LLM_MAX_TOKENS_PER_RUN=500000

# ─── Pre-Whisper noise reduction (optional, opt-in) ────────────────────────
# When `WHISPER_DENOISE=1`, transcribe-pleno.sh re-encodes the downloaded
# audio through ffmpeg's `afftdn` filter (FFT-based, built-in — no extra
# dependencies) before sending it to any Whisper backend. Worth trying on
# noisy plenos (long sessions, distant mics, post-DANA recovery rooms).
# Default OFF — clean recordings can lose consonant transients on
# aggressive denoise.
WHISPER_DENOISE=0

# ─── Speaker diarization (optional, opt-in) ────────────────────────────────
# When `WHISPER_DIARIZE=1`, transcribe-pleno.sh runs pyannote.audio's
# speaker-diarization-3.1 after Whisper and tags each transcript line with
# (SPEAKER_NN). Bootstrap requires a HuggingFace account, accepted user
# agreements on the pyannote model pages, and a read-only token here.
# Default OFF — plain Whisper transcripts work fine, just produce ~62-65%
# null-speakerGroup attribution downstream.
HUGGINGFACE_TOKEN=

# ─── GitHub right-of-reply ingestion (optional) ────────────────────────────
# `npm run refresh:gh-issues` snapshots the open `derecho-replica` issues so
# the curator dashboard can render them without hitting the GitHub API from
# the browser. Defaults to the public-clone path `datarhan/civicpulse`.
#
# If the repo is **private**, the unauthenticated endpoint returns 404 and
# the dashboard surfaces a refresh failure. Set GITHUB_TOKEN to a fine-
# grained or classic PAT with `repo` scope (read-only is enough) and the
# nightly + manual refresh both succeed. Override GITHUB_REPO if you've
# forked / mirrored to a different `owner/repo`.
GITHUB_REPO=datarhan/civicpulse
GITHUB_TOKEN=

# ─── Verifier shortlist backend ─────────────────────────────────────────────
# Controls how the LLM second-pass verifier picks candidate evidence rows.
#   lexical  (default) — word-overlap scoring, no API calls. Fast, cheap.
#   semantic — cosine similarity over OpenAI text-embedding-3-small. Higher
#              recall on synonyms / Catalan-Spanish doublets / paraphrases.
#              Requires `npm run embed:verifier-corpus` once + on each
#              corpus refresh; reads `.embed-cache/verifier-corpus.jsonl`.
#   hybrid   — union of both, deduped, sorted. Highest recall.
# Falls back to lexical with a warning when the cache or OPENAI_API_KEY
# is missing — never crashes the verifier.
VERIFIER_SHORTLIST=lexical

# ─── Journalist agent (/laboratorio/agentes) ────────────────────────────────
# The journalist agent runs a 4-stage pipeline (plan → research → synth →
# verify) for each assignment and writes machine-drafted reports to
# public/data/journalist-reports-suggestions.json. A curator promotes a
# draft to public/data/journalist-reports.json via `npm run promote-report`.
# See CLAUDE.md "Journalist agent (sensitive subsystem)" for the libel
# discipline.

# SearXNG (FREE, self-hosted) — preferred web-search backend.
#   Bootstrap:  npm run searxng:up
#   Verify:     curl -s 'http://localhost:8888/search?q=test&format=json' | head -c 400
#   Stop:       npm run searxng:down
# Compose file at scripts/searxng/docker-compose.yml. The instance aggregates
# Google + Bing + DuckDuckGo + Wikipedia + Wikidata + news engines, returns
# JSON, requires no key, has no rate-limit drama on localhost.
SEARXNG_URL=http://localhost:8888

# Exa REST API key (LEGACY / OPTIONAL PAID FALLBACK).
# Used ONLY when SEARXNG_URL is unset. Costs ~$1/M requests. SearXNG above
# gives equivalent results for free; this remains for users who already
# pay for Exa or prefer its neural ranking.
EXA_API_KEY=

# Per-assignment token budget for the journalist agent (default 200000).
# Lower it for cheap dry-runs; raise it for long biographies that need
# more Stage-2 research breadth. Token counts cover all four stages
# combined (plan + research-fetched URL bodies + synth + verify).
JOURNALIST_TOKEN_BUDGET=200000

# --- Front-end launch flags (Vite, VITE_ prefix = exposed to the client) ---
# "Periodistas IA" (the AI journalist agent at /laboratorio/agentes) drafts
# biographies of named living officials and is the highest legal-sensitivity
# surface in the app. It is HIDDEN from the public production build by default
# for the MVP launch, and stays available when running `npm run dev`. To
# re-publish it in production, set this to true (e.g. a Vercel env var) and
# redeploy. Keep in sync with PERIODISTAS_ENABLED in src/App.jsx.
VITE_ENABLE_PERIODISTAS=false

# ─── Mapa base (CARTO) ──────────────────────────────────────────────────────
# CARTO exige clave en sus teselas ráster desde 2026. SIN ella no falla nada:
# sirve la tesela con «API KEY REQUIRED» estampado encima y un 200 impecable,
# y los cuatro mapas del sitio (portada, /quejas/dashboard, /presupuesto,
# /empleo) salen marcados. Una clave MAL ESCRITA hace exactamente lo mismo,
# byte a byte, así que nada por HTTP puede distinguirla de una buena:
# `npm run check:basemap` compara la tesela con clave contra la de sin clave.
#
# Gratuita para uso no comercial (5M teselas/mes): https://carto.com/basemaps/apikey
# Viaja horneada en el paquete del navegador —no hay dónde esconderla en una
# SPA sin servidor— pero NO se comitea: CARTO no ofrece restricción por
# dominio, y quien la copie gasta nuestra cuota.
VITE_CARTO_API_KEY=
